<script>
    const initialParties = [
        { name: "Partit A", votes: 420000 },
        { name: "Partit B", votes: 310000 },
        { name: "Partit C", votes: 180000 },
        { name: "Partit D", votes: 95000 },
        { name: "Partit E", votes: 45000 },
        { name: "Partit F", votes: 18000 }
    ];

    let parties = initialParties.map(p => ({ ...p }));

    const colors = [
        "#174c3c",
        "#3478a8",
        "#d9a441",
        "#9b6bb3",
        "#d36b55",
        "#6c9182",
        "#6574a5",
        "#bb8a62",
        "#478b8b",
        "#8a8a8a"
    ];

    const numberFormat = new Intl.NumberFormat("ca-ES");

    function escapeHTML(value) {
        return String(value).replace(/[&<>"']/g, char => ({
            "&": "&amp;",
            "<": "&lt;",
            ">": "&gt;",
            '"': "&quot;",
            "'": "&#39;"
        })[char]);
    }

    function readInteger(value, minimum = 0) {
        const number = Number(value);

        if (!Number.isSafeInteger(number) || number < minimum) {
            return null;
        }

        return number;
    }

    function renderParties() {
        const tbody = document.getElementById("partyTable");
        tbody.innerHTML = "";

        parties.forEach((party, index) => {
            const row = document.createElement("tr");

            row.innerHTML = `
                <td>
                    <input
                        type="text"
                        aria-label="Nom del partit ${index + 1}"
                        value="${escapeHTML(party.name)}"
                        data-index="${index}"
                        data-field="name"
                        maxlength="100"
                    >
                </td>
                <td>
                    <input
                        type="number"
                        aria-label="Vots del partit ${index + 1}"
                        value="${party.votes}"
                        min="0"
                        step="1"
                        data-index="${index}"
                        data-field="votes"
                    >
                </td>
                <td>
                    <button
                        class="delete-button"
                        data-delete="${index}"
                        aria-label="Eliminar ${escapeHTML(party.name)}"
                    >Eliminar</button>
                </td>
            `;

            tbody.appendChild(row);
        });
    }

    document.getElementById("partyTable").addEventListener(
        "input",
        event => {
            const input = event.target;

            if (!input.dataset.field) return;

            const index = Number(input.dataset.index);
            const field = input.dataset.field;

            if (field === "name") {
                parties[index].name = input.value;
            }

            if (field === "votes") {
                const value = readInteger(input.value);

                parties[index].votes =
                    value === null ? 0 : value;
            }
        }
    );

    document.getElementById("partyTable").addEventListener(
        "click",
        event => {
            const button = event.target.closest("[data-delete]");

            if (!button) return;

            const index = Number(button.dataset.delete);
            parties.splice(index, 1);

            renderParties();
            calculate();
        }
    );

    document.getElementById("addParty").addEventListener(
        "click",
        () => {
            parties.push({
                name: "Partit nou",
                votes: 0
            });

            renderParties();

            const inputs = document.querySelectorAll(
                '#partyTable input[data-field="name"]'
            );

            if (inputs.length) {
                inputs[inputs.length - 1].focus();
                inputs[inputs.length - 1].select();
            }
        }
    );

    document.getElementById("calculate").addEventListener(
        "click", calculate
    );

    document.getElementById("calculate2").addEventListener(
        "click", calculate
    );

    document.getElementById("seats").addEventListener(
        "change", calculate
    );

    document.getElementById("threshold").addEventListener(
        "change", calculate
    );

    document.getElementById("blankVotes").addEventListener(
        "change", calculate
    );

    document.getElementById("reset").addEventListener(
        "click",
        () => {
            parties = initialParties.map(p => ({ ...p }));

            document.getElementById("seats").value = 16;
            document.getElementById("threshold").value = 3;
            document.getElementById("blankVotes").value = 0;

            renderParties();
            calculate();
        }
    );

    function calculate() {
        const seats = readInteger(
            document.getElementById("seats").value, 1
        );

        const threshold = Number(
            document.getElementById("threshold").value
        );

        const blankVotes = readInteger(
            document.getElementById("blankVotes").value
        );

        const message = document.getElementById("message");

        if (seats === null || seats > 100) {
            message.textContent =
                "El nombre de diputats ha de ser un enter entre 1 i 100.";
            return;
        }

        if (!Number.isFinite(threshold) ||
            threshold < 0 || threshold > 100) {
            message.textContent =
                "El llindar ha d'estar entre el 0 % i el 100 %.";
            return;
        }

        if (blankVotes === null) {
            message.textContent =
                "Els vots en blanc han de ser un enter no negatiu.";
            return;
        }

        for (let i = 0; i < parties.length; i++) {
            const party = parties[i];

            if (!party.name.trim()) {
                message.textContent =
                    "Tots els partits han de tindre un nom.";
                return;
            }

            if (!Number.isSafeInteger(party.votes) ||
                party.votes < 0) {
                message.textContent =
                    "Els vots han de ser enters no negatius.";
                return;
            }
        }

        const totalPartyVotes = parties.reduce(
            (sum, party) => sum + party.votes, 0
        );

        const validVotes = totalPartyVotes + blankVotes;

        const thresholdVotes = validVotes * threshold / 100;

        const results = parties.map((party, index) => ({
            ...party,
            originalIndex: index,
            percentage: validVotes > 0
                ? party.votes / validVotes * 100
                : 0,
            seats: 0,
            eligible: validVotes > 0 &&
                party.votes >= thresholdVotes &&
                party.votes > 0
        }));

        const eligibleParties = results.filter(
            party => party.eligible
        );

        /*
         * D'Hondt:
         * En cada iteració, s'assigna un escó al partit amb
         * el quocient més alt: vots / (escons + 1).
         *
         * En cas d'empat exacte, es manté el primer partit
         * en l'ordre d'entrada.
         */
        for (let seat = 0; seat < seats; seat++) {
            let winner = null;
            let bestQuotient = -1;

            for (const party of eligibleParties) {
                const quotient =
                    party.votes / (party.seats + 1);

                if (quotient > bestQuotient) {
                    bestQuotient = quotient;
                    winner = party;
                }
            }

            if (winner === null) break;

            winner.seats++;
        }

        results.sort((a, b) =>
            b.seats - a.seats ||
            b.votes - a.votes ||
            a.originalIndex - b.originalIndex
        );

        document.getElementById("totalVotes").textContent =
            numberFormat.format(totalPartyVotes);

        const allocated = results.reduce(
            (sum, party) => sum + party.seats, 0
        );

        document.getElementById("totalSeats").textContent =
            `${allocated} / ${seats}`;

        document.getElementById("represented").textContent =
            results.filter(party => party.seats > 0).length;

        renderResults(results, seats, totalPartyVotes);

        renderDetails(results);

        message.textContent =
            `Llindar: ${threshold} %. ` +
            `Vots vàlids considerats: ${numberFormat.format(validVotes)}. ` +
            `${eligibleParties.length} candidatures poden participar ` +
            `en el repartiment.`;

    }

    function renderResults(results, seats, totalVotes) {
        const container = document.getElementById("results");

        if (results.length === 0) {
            container.innerHTML =
                '<p class="empty">Afig almenys una candidatura.</p>';
            return;
        }

        container.innerHTML = results.map((party, index) => {
            const width = party.seats / seats * 100;
            const color = colors[
                party.originalIndex % colors.length
            ];

            let status = "";

            if (!party.eligible) {
                status = '<div class="excluded">Exclòs del repartiment</div>';
            } else if (party.seats === 0) {
                status = '<div class="excluded">Sense escons</div>';
            }

            return `
                <div class="result-row">
                    <div>
                        <div class="result-name">
                            ${escapeHTML(party.name)}
                        </div>
                        <div class="notice">
                            ${numberFormat.format(party.votes)} vots
                            · ${party.percentage.toFixed(2)} %
                        </div>
                        ${status}
                    </div>

                    <div class="bar-track"
                         aria-label="${party.seats} diputats">
                        <div class="bar"
                             style="width:${width}%;background:${color}">
                        </div>
                    </div>

                    <div class="seat-count">
                        ${party.seats}
                        <small>${party.seats === 1 ? "escó" : "escons"}</small>
                    </div>
                </div>
            `;
        }).join("");
    }

    function renderDetails(results) {
        const tbody = document.getElementById("detailTable");

        tbody.innerHTML = results.map(party => `
            <tr>
                <td>
                    ${escapeHTML(party.name)}
                    ${party.eligible
                        ? ""
                        : '<div class="excluded">No arriba al llindar</div>'}
                </td>
                <td class="number">
                    ${numberFormat.format(party.votes)}
                </td>
                <td class="number">
                    ${party.percentage.toFixed(2)} %
                </td>
                <td class="number">
                    <strong>${party.seats}</strong>
                </td>
            </tr>
        `).join("");
    }

    renderParties();
    calculate();
</script>

</body>
</html>
